# 追加到 dify/docker/.env（由 .env.example 复制而来）末尾的本地改动。
# <...> 为需自行生成的值，不要提交真实值。
VECTOR_STORE=milvus
COMPOSE_PROFILES=milvus,postgresql,collaboration
MILVUS_URI=http://host.docker.internal:19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus
# 不设会导致 local_sandbox/agent_backend 反复重启；生成：openssl rand -hex 24
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=<random-hex>
# 放行 host.docker.internal，让 HTTP 节点能访问记忆服务（副作用：宿主机所有端口可达）
SSRF_PROXY_ALLOW_PRIVATE_IPS=192.168.65.254/32,fdc4:f303:9324::254/128
SSRF_DEFAULT_TIME_OUT=120
SSRF_DEFAULT_READ_TIME_OUT=120
NGINX_CLIENT_MAX_BODY_SIZE=600M
UPLOAD_AUDIO_FILE_SIZE_LIMIT=200
UPLOAD_VIDEO_FILE_SIZE_LIMIT=500
UPLOAD_FILE_SIZE_LIMIT=50
